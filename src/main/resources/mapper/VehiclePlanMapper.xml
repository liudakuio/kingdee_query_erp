<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.kingdee.mapper.VehiclePlanMapper">

    <!-- 所有表名与列名均为固定字面量，用户输入只通过 #{} 绑定，杜绝 SQL 注入 -->
    <!-- resultType 指向 domain 下的 entity，MyBatis 按列名自动映射到同名属性 -->

    <select id="selectPlansByBillNo" resultType="com.ruoyi.kingdee.domain.VehiclePlan">
        SELECT * FROM tk_usp_vehicleplan WHERE fbillno = #{billNo}
    </select>

    <select id="selectPlansByFid" resultType="com.ruoyi.kingdee.domain.VehiclePlan">
        SELECT * FROM tk_usp_vehicleplan WHERE fid = #{fid}
    </select>

    <select id="selectPlanTc" resultType="com.ruoyi.kingdee.domain.VehiclePlanTc">
        SELECT * FROM tk_usp_vehicleplan_tc WHERE fid = #{fid}
    </select>

    <select id="selectContainerEntries" resultType="com.ruoyi.kingdee.domain.ContainerEntry">
        SELECT * FROM tk_usp_container_entry WHERE fid = #{fid} ORDER BY fseq, fentryid
    </select>

    <select id="selectSubEntries" resultType="com.ruoyi.kingdee.domain.Subentryentity">
        SELECT * FROM tk_usp_subentryentity
        WHERE fentryid IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY fentryid, fseq
    </select>

    <select id="selectVehicleEntries" resultType="com.ruoyi.kingdee.domain.VehicleEntry">
        SELECT * FROM tk_usp_vehicleentry WHERE fid = #{fid} ORDER BY fseq, fentryid
    </select>

</mapper>
