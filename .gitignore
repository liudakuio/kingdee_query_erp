# ============================================
# Java / Maven 构建产物
# ============================================
# Maven 编译输出目录（class 文件、jar 包等），可由 mvn package 重新生成
target/

# ============================================
# 日志文件
# ============================================
# 运行时产生的日志文件，属于动态数据，不应纳入版本控制
*.log

# ============================================
# IDE 配置文件
# ============================================
# IntelliJ IDEA 的项目配置目录（个人 IDE 设置，每人不同）
.idea/
# IDEA 的模块描述文件（与 .idea/ 同理，由 IDE 自动生成）
*.iml
# VS Code 编辑器配置目录
.vscode/

# ============================================
# 前端（Vue/Node）相关
# ============================================
# npm 安装的第三方依赖目录，体积巨大且可由 package.json + npm install 恢复
ruoyi-ui/node_modules/
# 前端打包构建产物，可由 npm run build 重新生成
ruoyi-ui/dist/
# 本地环境变量文件（含个人本机配置或敏感密钥，不共享到仓库）
ruoyi-ui/.env.local

# 金蝶对接配置（含密钥等敏感信息，不纳入版本控制）
application-kingdee.yml

# ============================================
# 操作系统文件
# ============================================
# macOS 访达在目录下生成的元数据文件，与代码无关
.DS_Store
